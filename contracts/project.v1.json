{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.grok/contracts/project.v1.json",
  "title": "ProjectPicks",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "controlPlane",
    "hands",
    "writerHarness",
    "writerModel",
    "isolate",
    "land",
    "envelopeStore",
    "access",
    "commitCredit",
    "promptCache"
  ],
  "properties": {
    "controlPlane": {
      "type": "string",
      "minLength": 1
    },
    "hands": {
      "type": "string",
      "minLength": 1
    },
    "writerHarness": {
      "type": "string",
      "minLength": 1
    },
    "writerModel": {
      "type": "string",
      "minLength": 1
    },
    "isolate": {
      "type": "string",
      "minLength": 1
    },
    "land": {
      "type": "string",
      "minLength": 1
    },
    "envelopeStore": {
      "type": "string",
      "minLength": 1
    },
    "access": {
      "type": "string",
      "minLength": 1
    },
    "commitCredit": {
      "type": "string",
      "minLength": 1
    },
    "promptCache": {
      "type": "string",
      "minLength": 1
    }
  },
  "description": "The project manager's live picks. Allowed ids live in factory/runtimes.json catalog. hands.mjs check is the gate. promptCache is how a seat reuses a stable prefix: native provider/runtime cache, not a home-grown answer store."
}

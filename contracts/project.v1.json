{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.grok/contracts/project.v1.json",
  "title": "ProjectPicks",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "controlPlane",
    "hands",
    "writerHarness",
    "writerModel",
    "isolate",
    "land",
    "envelopeStore",
    "access",
    "commitCredit",
    "promptCache",
    "helpMode"
  ],
  "properties": {
    "controlPlane": {
      "type": "string",
      "minLength": 1
    },
    "hands": {
      "type": "string",
      "minLength": 1
    },
    "writerHarness": {
      "type": "string",
      "minLength": 1
    },
    "writerModel": {
      "type": "string",
      "minLength": 1
    },
    "isolate": {
      "type": "string",
      "minLength": 1
    },
    "land": {
      "type": "string",
      "minLength": 1
    },
    "envelopeStore": {
      "type": "string",
      "minLength": 1
    },
    "access": {
      "type": "string",
      "minLength": 1
    },
    "commitCredit": {
      "type": "string",
      "minLength": 1
    },
    "promptCache": {
      "type": "string",
      "minLength": 1
    },
    "helpMode": {
      "type": "string",
      "minLength": 1
    }
  },
  "description": "The project manager's live picks. helpMode none means this repo is the product. fork-and-pr / collaborator-branch means this repo is a sidecar factory that helps another remote. Overlay is not a live pick."
}

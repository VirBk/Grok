{
  "product": "Dual-runtime factory. Strong control plane, dumb hands, cheap writer seats. Claude Code is absent by default. A DeepSeek or DashScope token is the writer, never the control plane.",
  "mistake": "Do not remap the control-plane session to DeepSeek, Qwen, or Cursor Cloud Agent. Do not give hands a model. Do not add a GitHub Action while the writer secret is missing.",
  "default": {
    "controlPlane": "grok-cloud",
    "hands": "hands.mjs",
    "writerHarness": "qwen-code",
    "writerModel": "qwen3-coder",
    "isolate": "worktree",
    "land": "ff-only",
    "envelopeStore": "git-blob",
    "access": "owner-only",
    "commitCredit": "owner-account",
    "promptCache": "local-kv",
    "helpMode": "none"
  },
  "catalog": {
    "controlPlane": [
      {
        "id": "grok-cloud",
        "recommended": true,
        "note": "Grok chat. Fuse. Successor is AGENTS, BOARD, envelope."
      },
      {
        "id": "claude-desktop",
        "recommended": false,
        "note": "Optional. Claude Code as judgment if the project manager already has it."
      }
    ],
    "hands": [
      {
        "id": "hands.mjs",
        "recommended": true,
        "note": "Dumb runner. No model. No keys. factory/tools/hands.mjs."
      },
      {
        "id": "claude-code",
        "recommended": false,
        "note": "Hands stay inside Claude Code. Do not remap that session onto a cheap model."
      }
    ],
    "writerHarness": [
      {
        "id": "qwen-code",
        "recommended": true,
        "note": "Qwen Code. Local Ollama or DashScope token. No Claude Code."
      },
      {
        "id": "aider",
        "recommended": true,
        "note": "Git-native CLI. OpenAI-compat. No Claude Code. DEEPSEEK_API_KEY or DASHSCOPE_API_KEY in env."
      },
      {
        "id": "opencode",
        "recommended": false,
        "note": "Multi-model local harness."
      },
      {
        "id": "goose",
        "recommended": false,
        "note": "Recipe runner. Local."
      },
      {
        "id": "deepseek-openai",
        "recommended": true,
        "note": "Any OpenAI-compat client pointed at DeepSeek. No Claude Code. Token in env."
      },
      {
        "id": "claude-code",
        "recommended": false,
        "note": "Claude Code harness with ANTHROPIC_BASE_URL remapped. Writer seat only."
      },
      {
        "id": "cursor-desktop",
        "recommended": false,
        "note": "Local Cursor Chat/Agent may BYOK DeepSeek/Qwen. Cursor Cloud Agents, background, automations, and CLI cannot. Do not install Cursor to emulate the factory."
      }
    ],
    "writerModel": [
      {
        "id": "qwen3-coder",
        "recommended": true,
        "note": "Local Ollama (local-kv) or DashScope token (provider-prefix). Not Claude Code."
      },
      {
        "id": "deepseek-flash",
        "recommended": true,
        "note": "Sweep writer."
      },
      {
        "id": "deepseek-v4-pro",
        "recommended": true,
        "note": "Keystone writer."
      }
    ],
    "isolate": [
      {
        "id": "worktree",
        "recommended": true,
        "note": "git worktree from live main on the machine that runs hands."
      },
      {
        "id": "cloud-clone",
        "recommended": false,
        "note": "Generic VPS/Fly clone print. Prefer git-bus or codespace."
      },
      {
        "id": "git-bus",
        "recommended": true,
        "note": "Cloud CP writes the envelope blob. The PC that already autobuilds fetches and isolates. No new machine."
      },
      {
        "id": "codespace",
        "recommended": true,
        "note": "Throwaway GitHub Codespace. Writer token is a Codespaces secret, not git, not an Action. Printed gh create; not a red workflow."
      },
      {
        "id": "help-clone",
        "recommended": true,
        "note": "Sibling clone of factory/help.json target. Not a second remote on this repo. Envelope holds are product paths."
      }
    ],
    "land": [
      {
        "id": "ff-only",
        "recommended": true,
        "note": "git merge --ff-only after APPROVED. Local hands."
      },
      {
        "id": "github-rebase-after-approved",
        "recommended": true,
        "note": "PR rebase after VERDICT: APPROVED. Printed, not a red Action."
      }
    ],
    "envelopeStore": [
      {
        "id": "git-blob",
        "recommended": true,
        "note": "factory/envelopes/<lane>.md. Deleted on land. Issues are not the board."
      }
    ],
    "access": [
      {
        "id": "owner-only",
        "recommended": true,
        "note": "Only the GitHub owner produces landed commits. Children return intakes. Parent default. Collaborator invite is not this pick."
      },
      {
        "id": "fork-and-pull",
        "recommended": true,
        "note": "Anyone with read forks and opens a PR. Merge credits them as a GitHub contributor. They never receive write. They never push main."
      },
      {
        "id": "collaborator-write",
        "recommended": false,
        "note": "Invite write. Topic branches. Owner still lands main. Write access is not a contributor; a landed commit is."
      }
    ],
    "commitCredit": [
      {
        "id": "owner-account",
        "recommended": true,
        "note": "Author email is on the owner's GitHub account. Else the commit is anonymous on Insights and the contribution graph."
      },
      {
        "id": "github-noreply",
        "recommended": true,
        "note": "login@users.noreply.github.com (or id+login@). Counts if that noreply address is on the account."
      },
      {
        "id": "co-authored-by-owner",
        "recommended": true,
        "note": "Seat may author. Message includes Co-authored-by: Name <email on the owner account>. Factory email grok@factory is a miss."
      }
    ],
    "promptCache": [
      {
        "id": "provider-prefix",
        "recommended": true,
        "note": "Native API prefix cache (DeepSeek disk, Grok automatic, Qwen implicit). Stable prefix first. Paste prompt_cache_hit_tokens or cached_tokens."
      },
      {
        "id": "explicit-breakpoint",
        "recommended": false,
        "note": "Claude or Qwen cache_control markers. Use when the harness can set them. Same prefix law."
      },
      {
        "id": "local-kv",
        "recommended": true,
        "note": "Ollama / vLLM / llama.cpp prefix KV cache on the autobuild PC. Free. Same prefix law. No bill line."
      },
      {
        "id": "off",
        "recommended": false,
        "note": "Do not rely on cache. Still keep the prefix stable so a later pick can turn it on."
      }
    ],
    "helpMode": [
      {
        "id": "none",
        "recommended": true,
        "note": "This repo is the product. Parent default."
      },
      {
        "id": "fork-and-pr",
        "recommended": true,
        "note": "Sidecar factory. Fork the target. PR product files only. Never land target main. Never put factory/ in that PR."
      },
      {
        "id": "collaborator-branch",
        "recommended": true,
        "note": "Invited write on the target. Topic branches. Factory files stay in this repo. Target owner still lands main."
      },
      {
        "id": "overlay-pin",
        "recommended": false,
        "note": "Copy the kit into the product. Alumni (Otto, Virbos) refuse this without a quiet week, kit SHA pin, and owner word. Not a GitHub fork of Grok."
      }
    ]
  },
